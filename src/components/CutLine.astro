---
interface Props {
  theme: 'light' | 'dark';
}

const { theme } = Astro.props;
const clipPositions = [14, 32, 50, 68, 84];
---

<div class={`cut-bar cut-bar--${theme}`}>
  <div class="cut-line" data-cutline></div>
  {clipPositions.map((left) => (
    <span class="cut-clip" style={`left:${left}%`} data-clip></span>
  ))}
  <div class="cut-scissors" data-scissors>
    <svg viewBox="0 0 112 64" width="54" height="31" aria-hidden="true">
      <g class="scissors-blade-top">
        <circle cx="17" cy="17" r="11" fill="none" stroke="currentColor" stroke-width="4.5"></circle>
        <line x1="25" y1="22" x2="104" y2="42" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"></line>
      </g>
      <g class="scissors-blade-bottom">
        <circle cx="17" cy="47" r="11" fill="none" stroke="currentColor" stroke-width="4.5"></circle>
        <line x1="25" y1="42" x2="104" y2="22" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"></line>
      </g>
      <circle cx="64" cy="32" r="3.6" fill="currentColor"></circle>
    </svg>
  </div>
</div>

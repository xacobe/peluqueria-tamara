---
import CutLine from './CutLine.astro';
import { dict, DEFAULT_LANG } from '../i18n/dict';

const t = dict[DEFAULT_LANG];
const images = [
  'tamara-core-2.jpg',
  'tamara-corte-1.webp',
  'tamara-corte-3.jpg',
  'tamara-corte-4.jpg',
  'tamara-corte-5.jpg',
  'tamara-corte-6.jpg',
  'tamara-corte-7.jpg',
  'tamara-corte-8.jpg',
];
---

<section id="galeria" class="section section--dark" data-reveal>
  <CutLine theme="dark" />

  <div class="eyebrow piece" data-piece><span data-i18n="gallery_eyebrow">{t.gallery_eyebrow}</span></div>
  <h2 class="heading-section piece" data-piece data-i18n="gallery_title">{t.gallery_title}</h2>
  <p class="section-sub section-sub--dark piece" data-piece data-i18n="gallery_sub">{t.gallery_sub}</p>

  <div class="gallery-grid">
    {images.map((file) => (
      <div class="gallery-photo piece-fast" data-piece>
        <img src={`/${file}`} alt="Trabajo de Tamara Margüenda" loading="lazy" />
      </div>
    ))}
  </div>
</section>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }

  .gallery-photo {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 5px;
    overflow: hidden;
    background: repeating-linear-gradient(135deg, #24382c 0 16px, #2c4636 16px 32px);
  }

  .gallery-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

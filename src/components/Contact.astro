---
import CutLine from './CutLine.astro';
import { dict, DEFAULT_LANG } from '../i18n/dict';

const t = dict[DEFAULT_LANG];
const whatsappHref = 'https://wa.me/34886126654';
---

<section id="contacto" class="section section--dark section--contact" data-reveal>
  <CutLine theme="dark" />

  <div class="contact-grid">
    <div>
      <div class="eyebrow piece" data-piece><span data-i18n="contact_eyebrow">{t.contact_eyebrow}</span></div>
      <h2 class="heading-section contact-title piece" data-piece data-i18n="contact_title">{t.contact_title}</h2>

      <div class="contact-rows piece-fast" data-piece>
        <div class="contact-row">
          <div class="contact-label" data-i18n="contact_addr_label">{t.contact_addr_label}</div>
          <div data-i18n="contact_addr_val">{t.contact_addr_val}</div>
        </div>
        <div class="contact-row">
          <div class="contact-label" data-i18n="contact_hours_label">{t.contact_hours_label}</div>
          <div data-i18n="contact_hours_val">{t.contact_hours_val}</div>
        </div>
        <div class="contact-row">
          <div class="contact-label" data-i18n="contact_phone_label">{t.contact_phone_label}</div>
          <div data-i18n="contact_phone_val">{t.contact_phone_val}</div>
        </div>
        <div class="contact-row contact-row--last">
          <div class="contact-label" data-i18n="contact_ig_label">{t.contact_ig_label}</div>
          <a href="https://www.instagram.com/tamara.marguenda/" target="_blank" rel="noopener" class="contact-ig">@tamara.marguenda</a>
        </div>
      </div>

      <a
        data-i18n="contact_cta"
        href={whatsappHref}
        target="_blank"
        rel="noopener"
        class="btn btn-cream contact-cta piece-fast"
        data-piece
      >{t.contact_cta}</a>
    </div>

    <div class="contact-map piece-fast" data-piece>
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2953.9488014936314!2d-8.722689523312699!3d42.23690677120471!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd2f63f222eab78f%3A0x277dcdcf127eeb68!2sTamara%20Marg%C3%BCenda!5e0!3m2!1sgl!2sbf!4v1782202624301!5m2!1sgl!2sbf"
        title="Ubicación de Tamara Margüenda"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .section--contact {
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .contact-title {
    margin: 8px 0 clamp(24px, 3vw, 36px);
  }

  .contact-rows {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 34em;
  }

  .contact-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 12px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(244, 242, 236, .14);
    font-size: 17px;
    line-height: 1.5;
  }
  .contact-row--last {
    padding-bottom: 0;
    border-bottom: none;
  }

  .contact-label {
    font-size: 12px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--on-dark-muted-2);
    padding-top: 3px;
  }

  .contact-ig {
    color: var(--accent);
    text-decoration: none;
  }
  .contact-ig:hover {
    text-decoration: underline;
  }

  .contact-cta {
    margin-top: clamp(26px, 3vw, 36px);
  }

  .contact-map {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 6px;
    overflow: hidden;
    background: repeating-linear-gradient(135deg, #24382c 0 18px, #2c4636 18px 36px);
    border: 1px solid rgba(244, 242, 236, .12);
  }

  .contact-map iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

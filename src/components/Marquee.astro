---
const items = ['Tamara Margüenda', 'Corte', 'Color', 'Estilo'];
---

<div class="marquee">
  <div class="marquee-track">
    {[0, 1].map(() => (
      items.map((label) => (
        <>
          <span>{label}</span>
          <span class="marquee-star">✶</span>
        </>
      ))
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    background: var(--green-deep);
    padding: 16px 0;
    border-top: 1px solid rgba(244, 242, 236, .08);
    border-bottom: 1px solid rgba(244, 242, 236, .08);
  }

  .marquee-track {
    display: inline-flex;
    white-space: nowrap;
    animation: marquee 26s linear infinite;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 800;
    font-size: clamp(22px, 3.4vw, 44px);
    color: var(--cream);
    letter-spacing: -.01em;
  }

  .marquee-track span {
    padding: 0 26px;
  }

  .marquee-star {
    color: var(--accent);
  }
</style>
